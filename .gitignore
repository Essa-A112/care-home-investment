# Environment
.env

# Data files (download locally via pipeline) – keep directory stubs
# The negation of !**/.gitkeep requires parent dirs to not be excluded,
# so we exclude files/non-.gitkeep entries rather than whole directories.
data/**/*
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.DS_Store
.idea/
.vscode/

# Node / Frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.env

# Jupyter
.ipynb_checkpoints/

# Models (large binary artifacts)
*.cbm
*.pkl
